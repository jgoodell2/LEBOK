upstream web_server {
    server 127.0.0.1:8080; # Replace with wikijs website address
}

upstream graphql_handler {
    server 127.0.0.1:9000; # Replace with microservice address
}

map $http_accept $target_backend {
    "~*application/json"    graphql_handler;
    "~*application/ld\+json"  graphql_handler;
    default                 web_server;
}

server {
    listen 80;
    
    location / {
	# Forward the request to the backend selected by the map
	proxy_pass http://$target_backend;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
    }
}
